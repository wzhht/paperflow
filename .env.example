# Fill your own API credentials below. Keep this file private after copying to .env.
# 请填写自己的API；复制为.env后仅保存在本机，不上传密钥。
ELSEVIER_API_KEY=
# Optional authorized institution token; campus IP may work without this.
ELSEVIER_INSTTOKEN=
SPRINGER_OA_API_KEY=
SPRINGER_META_API_KEY=

# PDF parser: api (default, precision), api-light (limited quality). No local GPU.
# PDF默认使用完整API；不需要本地GPU，上传解析可能消耗额度。
MINERU_BACKEND=api
MINERU_API_TOKEN=
MINERU_API_MODEL=vlm
MINERU_API_TIMEOUT=600

# Optional additional-source metadata / OA discovery
CROSSREF_MAILTO=
OPENALEX_API_KEY=
UNPAYWALL_EMAIL=
IEEE_API_KEY=
# Optional. Leave disabled until the IEEE developer/API gateway issue is resolved.
IEEE_API_ENABLED=false
# Wiley TDM token. Alias Wiley_API_KEY is accepted for existing user configuration.
WILEY_API_KEY=
